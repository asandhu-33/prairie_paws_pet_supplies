<div class="container py-4 pb-5">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
      <h1 class="h3 mb-1">Shopping Cart</h1>
      <p class="text-muted small mb-0">Review your items, adjust quantities, or proceed to checkout.</p>
    </div>
    <%= link_to "← Continue Shopping", products_path, class: "btn btn-outline-secondary btn-sm" %>
  </div>

  <% if @cart_items.empty? %>
    <div class="card border-0 shadow-sm text-center p-5">
      <p class="fs-5 text-muted mb-3">Your shopping cart is currently empty.</p>
      <div>
        <%= link_to "Browse Products", products_path, class: "btn btn-primary px-4" %>
      </div>
    </div>
  <% else %>
    <div class="card border-0 shadow-sm mb-4">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th class="ps-4">Product</th>
              <th style="width: 130px;">Unit Price</th>
              <th style="width: 195px;">Quantity</th>
              <th style="width: 140px;">Subtotal</th>
              <th class="pe-4 text-end" style="width: 120px;">Action</th>
            </tr>
          </thead>
          <tbody>
            <% @cart_items.each do |item| %>
              <% product = item[:product] %>
              <tr>
                <td class="ps-4 py-3">
                  <div class="d-flex align-items-center gap-3">
                    <% if product.image.attached? %>
                      <%= image_tag product.image,
                                    style: "width: 64px; height: 64px; object-fit: cover;",
                                    class: "rounded border flex-shrink-0",
                                    alt: product.name %>
                    <% end %>
                    <div>
                      <%= link_to product.name, product_path(product), class: "fw-semibold text-decoration-none d-block" %>
                      <span class="badge bg-light text-secondary border mt-1">In Stock: <%= product.stock %></span>
                    </div>
                  </div>
                </td>
                <td class="py-3">$<%= number_with_precision(product.price, precision: 2) %></td>
                <td class="py-3">
                  <%= form_with url: update_item_cart_path(product_id: product.id), method: :patch, local: true, class: "d-flex align-items-center gap-2" do |f| %>
                    <%= f.number_field :quantity,
                                       value: item[:quantity],
                                       min: 1,
                                       max: product.stock,
                                       class: "form-control form-control-sm",
                                       style: "width: 78px;" %>
                    <%= f.submit "Update", class: "btn btn-sm btn-outline-primary" %>
                  <% end %>
                </td>
                <td class="py-3 fw-semibold">$<%= number_with_precision(item[:line_total], precision: 2) %></td>
                <td class="pe-4 py-3 text-end">
                  <%= button_to "Remove",
                                remove_item_cart_path(product_id: product.id),
                                method: :delete,
                                class: "btn btn-sm btn-outline-danger" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="row g-3 align-items-center justify-content-between">
      <div class="col-sm-auto">
        <%= button_to "Clear Cart",
                      clear_cart_path,
                      method: :delete,
                      class: "btn btn-outline-danger btn-sm",
                      data: { turbo_confirm: "Are you sure you want to remove all items from your cart?" } %>
      </div>

      <div class="col-sm-auto ms-sm-auto">
        <div class="card border-0 shadow-sm">
          <div class="card-body px-4 py-3 text-sm-end">
            <div class="text-muted small mb-1">Estimated Subtotal (before taxes)</div>
            <div class="fs-4 fw-bold mb-3">
              $<%= number_with_precision(@subtotal, precision: 2) %>
            </div>
            <%= link_to "Proceed to Checkout", checkout_path, class: "btn btn-success px-4" %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>