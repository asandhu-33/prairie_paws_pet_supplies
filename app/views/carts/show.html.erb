<div class="container pb-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Shopping Cart</h1>
    <%= link_to "← Continue Shopping", products_path, class: "btn btn-outline-secondary btn-sm" %>
  </div>

  <% if @cart_items.empty? %>
    <div class="card text-center p-5">
      <p class="fs-5 text-muted mb-3">Your shopping cart is currently empty.</p>
      <div>
        <%= link_to "Browse Products", products_path, class: "btn btn-primary" %>
      </div>
    </div>
  <% else %>
    <div class="table-responsive mb-4">
      <table class="table table-bordered align-middle bg-white">
        <thead class="table-light">
          <tr>
            <th>Product</th>
            <th style="width: 130px;">Unit Price</th>
            <th style="width: 190px;">Quantity</th>
            <th style="width: 140px;">Subtotal</th>
            <th style="width: 110px;">Action</th>
          </tr>
        </thead>
        <tbody>
          <% @cart_items.each do |item| %>
            <% product = item[:product] %>
            <tr>
              <td>
                <div class="d-flex align-items-center gap-3">
                  <% if product.image.attached? %>
                    <%= image_tag product.image,
                                  style: "width: 60px; height: 60px; object-fit: cover;",
                                  class: "rounded",
                                  alt: product.name %>
                  <% end %>
                  <div>
                    <%= link_to product.name, product_path(product), class: "fw-semibold text-decoration-none" %>
                    <div class="text-muted small">In Stock: <%= product.stock %></div>
                  </div>
                </div>
              </td>
              <td>$<%= number_with_precision(product.price, precision: 2) %></td>
              <td>
                <%= form_with url: update_item_cart_path(product_id: product.id), method: :patch, local: true, class: "d-flex gap-2" do |f| %>
                  <%= f.number_field :quantity,
                                     value: item[:quantity],
                                     min: 0,
                                     max: product.stock,
                                     class: "form-control form-control-sm",
                                     style: "width: 75px;" %>
                  <%= f.submit "Update", class: "btn btn-sm btn-outline-primary" %>
                <% end %>
              </td>
              <td class="fw-semibold">$<%= number_with_precision(item[:line_total], precision: 2) %></td>
              <td>
                <%= button_to "Remove",
                              remove_item_cart_path(product_id: product.id),
                              method: :delete,
                              class: "btn btn-sm btn-outline-danger" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
      <%= button_to "Clear Cart",
                    clear_cart_path,
                    method: :delete,
                    class: "btn btn-outline-danger btn-sm",
                    data: { turbo_confirm: "Are you sure you want to remove all items from your cart?" } %>

      <div class="text-end">
        <div class="fs-5 fw-bold mb-2">
          Cart Subtotal: $<%= number_with_precision(@subtotal, precision: 2) %>
        </div>
        <span class="text-muted small">Saved in your browser session</span>
      </div>
    </div>
  <% end %>
</div>