<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Prairie Paws Pet Supplies" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  </head>

  <body>
    <% nav_categories = Category.where(name: %w[Dogs Cats]).order(:name) %>

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
      <div class="container">
        <%= link_to "Prairie Paws Pet Supplies", root_path, class: "navbar-brand fw-bold" %>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="mainNav">
          <ul class="navbar-nav me-auto mb-2 mb-lg-0">
            <li class="nav-item">
              <%= link_to "All Products", products_path, class: "nav-link" %>
            </li>
            <li class="nav-item">
              <%= link_to "On Sale", products_path(filter: "sale"), class: "nav-link" %>
            </li>
            <li class="nav-item">
              <%= link_to "New Arrivals", products_path(filter: "new"), class: "nav-link" %>
            </li>
            <% nav_categories.each do |category| %>
              <li class="nav-item">
                <%= link_to category.name, products_path(category_id: category.id), class: "nav-link" %>
              </li>
            <% end %>
            <li class="nav-item">
              <%= link_to "About", about_path, class: "nav-link" %>
            </li>
            <li class="nav-item">
              <%= link_to "Contact", contact_path, class: "nav-link" %>
            </li>
          </ul>

          <%= form_with url: products_path, method: :get, local: true, class: "d-flex gap-2" do |f| %>
            <%= f.select :category_id,
                         options_from_collection_for_select(nav_categories, :id, :name, params[:category_id]),
                         { include_blank: "All Categories" },
                         class: "form-select form-select-sm" %>
            <%= f.search_field :q, value: params[:q], placeholder: "Search products...", class: "form-control form-control-sm" %>
            <%= f.submit "Search", class: "btn btn-primary btn-sm" %>
          <% end %>

          <ul class="navbar-nav ms-lg-3 mb-2 mb-lg-0 align-items-lg-center">
            <% if defined?(user_signed_in?) && user_signed_in? %>
              <li class="nav-item">
                <%= link_to "My Account", edit_user_registration_path, class: "nav-link" %>
              </li>
              <li class="nav-item">
                <%= button_to "Log Out", destroy_user_session_path, method: :delete, class: "btn btn-outline-light btn-sm ms-lg-2" %>
              </li>
            <% elsif defined?(new_user_session_path) %>
              <li class="nav-item">
                <%= link_to "Log In", new_user_session_path, class: "nav-link" %>
              </li>
              <li class="nav-item">
                <%= link_to "Sign Up", new_user_registration_path, class: "btn btn-outline-light btn-sm ms-lg-2" %>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
    </nav>

    <div class="container">
      <% if notice.present? %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          <%= notice %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% end %>
      <% if alert.present? %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <%= alert %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% end %>
    </div>

    <%= yield %>
  </body>
</html>