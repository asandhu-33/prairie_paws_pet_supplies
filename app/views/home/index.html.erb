<div class="container my-5">
  <!-- Hero Section -->
  <div class="p-5 mb-4 bg-light rounded-3 shadow-sm border">
    <div class="container-fluid py-5">
      <h1 class="display-5 fw-bold text-primary">Welcome to Prairie Paws Pet Supplies! 🐾</h1>
      <p class="col-md-8 fs-4 text-muted">
        Your premier Winnipeg destination for premium dog and cat food, toys, treats, and everyday essentials.
      </p>
      <%= link_to "Browse Products", products_path, class: "btn btn-primary btn-lg px-4 gap-3 mt-3" %>
    </div>
  </div>

  <!-- Features / Quick Links Section -->
  <div class="row align-items-md-stretch g-4">
    <div class="col-md-6">
      <div class="h-100 p-5 bg-white border rounded-3 shadow-sm">
        <h2>🐶 Dog Essentials</h2>
        <p>Explore high-quality nutrition, durable chew toys, comfortable beds, and grooming supplies tailored for dogs of all sizes.</p>
        <%= link_to "Shop Dogs", products_path(pet: "dogs"), class: "btn btn-outline-secondary" %>
      </div>
    </div>
    <div class="col-md-6">
      <div class="h-100 p-5 bg-white border rounded-3 shadow-sm">
        <h2>🐱 Cat Essentials</h2>
        <p>Discover gourmet cat food, engaging teaser toys, scratching posts, and cozy litter solutions for your feline friends.</p>
        <%= link_to "Shop Cats", products_path(pet: "cats"), class: "btn btn-outline-secondary" %>
      </div>
    </div>
  </div>
</div>