<div class="container py-4 pb-5">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
      <h1 class="h3 mb-1"><%= @order.order_number.presence || "Order ##{@order.id}" %></h1>
      <p class="text-muted small mb-0">
        Placed on <%= @order.created_at.strftime("%B %d, %Y at %I:%M %p") %> ·
        <span class="badge bg-success"><%= @order.status %></span>
      </p>
    </div>
    <div class="d-flex gap-2">
      <%= link_to "← Back to My Orders", orders_path, class: "btn btn-outline-secondary btn-sm" %>
      <%= link_to "Continue Shopping", products_path, class: "btn btn-primary btn-sm" %>
    </div>
  </div>

  <div class="row g-4">
    <div class="col-lg-8">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white">
          <h2 class="h6 mb-0">Items Ordered</h2>
        </div>
        <div class="card-body">
          <%= render "orders/order_items_table", order: @order %>
        </div>
      </div>
    </div>

    <div class="col-lg-4">
      <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-white">
          <h2 class="h6 mb-0">Shipping Details</h2>
        </div>
        <div class="card-body small">
          <p class="mb-1"><strong><%= @order.user&.name.presence || @order.user&.email %></strong></p>
          <% if @order.shipping_address.present? %>
            <p class="mb-1"><%= @order.shipping_address %></p>
          <% end %>
          <p class="mb-0">
            <%= [@order.shipping_city, @order.shipping_province, @order.shipping_postal_code].compact_blank.join(", ") %>
          </p>
        </div>
      </div>

      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white">
          <h2 class="h6 mb-0">Order Summary</h2>
        </div>
        <div class="card-body">
          <%= render "orders/tax_breakdown", order: @order %>
        </div>
      </div>
    </div>
  </div>
</div>