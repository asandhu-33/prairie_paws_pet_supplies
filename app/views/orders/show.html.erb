<div class="container py-4 pb-5">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
      <h1 class="h3 mb-1">Order <%= @order.order_number.presence || "##{@order.id}" %></h1>
      <p class="text-muted small mb-0">
        Placed on <%= @order.created_at.strftime("%B %d, %Y at %I:%M %p") %> ·
        <span class="badge bg-success"><%= @order.status %></span>
      </p>
    </div>
    <%= link_to "← Back to My Orders", orders_path, class: "btn btn-outline-secondary btn-sm" %>
  </div>

  <div class="row g-4">
    <div class="col-lg-7">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white fw-semibold">Items Ordered</div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th class="ps-4">Product</th>
                  <th class="text-center">Qty</th>
                  <th class="text-end">Unit Price</th>
                  <th class="pe-4 text-end">Line Total</th>
                </tr>
              </thead>
              <tbody>
                <% @order.order_items.each do |item| %>
                  <% line_total = item.unit_price.to_d * item.quantity.to_i %>
                  <tr>
                    <td class="ps-4">
                      <% if item.product %>
                        <%= link_to item.product.name, product_path(item.product), class: "fw-semibold text-decoration-none" %>
                      <% else %>
                        <span class="text-muted">Product unavailable</span>
                      <% end %>
                    </td>
                    <td class="text-center"><%= item.quantity %></td>
                    <td class="text-end">$<%= number_with_precision(item.unit_price || 0, precision: 2) %></td>
                    <td class="pe-4 text-end fw-semibold">$<%= number_with_precision(line_total, precision: 2) %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <div class="col-lg-5">
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white fw-semibold">Shipping Details</div>
        <div class="card-body">
          <div class="fw-semibold"><%= current_user.name.presence || current_user.email %></div>
          <div><%= @order.shipping_address.presence || "No street address provided" %></div>
          <div>
            <%= [@order.shipping_city.presence, @order.shipping_postal_code.presence].compact.join(", ") %>
          </div>
          <div class="text-muted small mt-1">
            Province: <%= @order.shipping_province.presence || @order.province&.name %>
          </div>
        </div>
      </div>

      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white fw-semibold">Invoice Breakdown</div>
        <div class="card-body">
          <div class="d-flex justify-content-between mb-2">
            <span>Subtotal</span>
            <span>$<%= number_with_precision(@order.subtotal || 0, precision: 2) %></span>
          </div>

          <% if @order.gst_amount.to_d > 0 %>
            <div class="d-flex justify-content-between mb-2 text-muted">
              <span>GST (<%= number_to_percentage(@order.gst_rate.to_d * 100, precision: 2) %>)</span>
              <span>$<%= number_with_precision(@order.gst_amount, precision: 2) %></span>
            </div>
          <% end %>

          <% if @order.pst_amount.to_d > 0 %>
            <div class="d-flex justify-content-between mb-2 text-muted">
              <span>PST (<%= number_to_percentage(@order.pst_rate.to_d * 100, precision: 2) %>)</span>
              <span>$<%= number_with_precision(@order.pst_amount, precision: 2) %></span>
            </div>
          <% end %>

          <% if @order.hst_amount.to_d > 0 %>
            <div class="d-flex justify-content-between mb-2 text-muted">
              <span>HST (<%= number_to_percentage(@order.hst_rate.to_d * 100, precision: 2) %>)</span>
              <span>$<%= number_with_precision(@order.hst_amount, precision: 2) %></span>
            </div>
          <% end %>

          <div class="d-flex justify-content-between mb-2">
            <span>Total Tax</span>
            <span>$<%= number_with_precision(@order.tax_total || 0, precision: 2) %></span>
          </div>

          <hr>

          <div class="d-flex justify-content-between fs-5 fw-bold">
            <span>Grand Total</span>
            <span>$<%= number_with_precision(@order.total || 0, precision: 2) %></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>