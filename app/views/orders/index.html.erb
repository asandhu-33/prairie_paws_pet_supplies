<div class="container py-4 pb-5">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
      <h1 class="h3 mb-1">My Past Orders</h1>
      <p class="text-muted small mb-0">Review your past orders, products ordered, taxes, and grand totals.</p>
    </div>
    <%= link_to "← Continue Shopping", products_path, class: "btn btn-outline-secondary btn-sm" %>
  </div>

  <% if @orders.empty? %>
    <div class="card border-0 shadow-sm text-center p-5">
      <p class="fs-5 text-muted mb-3">You haven't placed any orders yet.</p>
      <div>
        <%= link_to "Browse Products", products_path, class: "btn btn-primary px-4" %>
      </div>
    </div>
  <% else %>
    <div class="d-flex flex-column gap-3">
      <% @orders.each do |order| %>
        <div class="card border-0 shadow-sm">
          <div class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
              <span class="fw-bold"><%= order.order_number.presence || "Order ##{order.id}" %></span>
              <span class="text-muted small ms-2">Placed on <%= order.created_at.strftime("%b %d, %Y") %></span>
              <span class="badge bg-success ms-2"><%= order.status %></span>
            </div>
            <%= link_to "Full Invoice", order_path(order), class: "btn btn-sm btn-outline-primary" %>
          </div>

          <div class="card-body">
            <div class="mb-3">
              <%= render "orders/order_items_table", order: order %>
            </div>

            <div class="row justify-content-end">
              <div class="col-md-6 col-lg-5">
                <%= render "orders/tax_breakdown", order: order %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>