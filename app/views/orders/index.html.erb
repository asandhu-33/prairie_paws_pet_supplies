<div class="container py-4 pb-5">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
      <h1 class="h3 mb-1">My Orders</h1>
      <p class="text-muted small mb-0">View your placed orders, invoices, and shipping details.</p>
    </div>
    <%= link_to "← Continue Shopping", products_path, class: "btn btn-outline-secondary btn-sm" %>
  </div>

  <% if @orders.empty? %>
    <div class="card border-0 shadow-sm text-center p-5">
      <p class="fs-5 text-muted mb-3">You haven't placed any orders yet.</p>
      <div>
        <%= link_to "Browse Products", products_path, class: "btn btn-primary px-4" %>
      </div>
    </div>
  <% else %>
    <div class="card border-0 shadow-sm">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th class="ps-4">Order #</th>
              <th>Date</th>
              <th>Province</th>
              <th>Status</th>
              <th class="text-end">Tax</th>
              <th class="text-end">Total</th>
              <th class="pe-4 text-end">Invoice</th>
            </tr>
          </thead>
          <tbody>
            <% @orders.each do |order| %>
              <tr>
                <td class="ps-4 fw-semibold"><%= order.order_number.presence || "Order ##{order.id}" %></td>
                <td><%= order.created_at.strftime("%b %d, %Y") %></td>
                <td><%= order.shipping_province.presence || order.province&.name %></td>
                <td><span class="badge bg-success"><%= order.status %></span></td>
                <td class="text-end">$<%= number_with_precision(order.tax_total || 0, precision: 2) %></td>
                <td class="text-end fw-semibold">$<%= number_with_precision(order.total || 0, precision: 2) %></td>
                <td class="pe-4 text-end">
                  <%= link_to "View Details", order_path(order), class: "btn btn-sm btn-outline-primary" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>
</div>