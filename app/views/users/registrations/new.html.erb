<% content_for(:title) { "Sign Up | Prairie Paws Pet Supplies" } %>

<div class="container my-5">
  <div class="row justify-content-center">
    <div class="col-12 col-sm-10 col-md-8 col-lg-6 mx-auto">
      <div class="card shadow-sm border auth-card">
        <div class="card-body p-4 p-md-5">
          <h1 class="h3 fw-bold mb-4 text-center">Create an Account</h1>

          <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
            <%= render "users/shared/error_messages", resource: resource %>

            <div class="mb-3">
              <%= f.label :name, "Full Name", class: "form-label fw-semibold" %>
              <%= f.text_field :name, autofocus: true, class: "form-control" %>
            </div>

            <div class="mb-3">
              <%= f.label :email, class: "form-label fw-semibold" %>
              <%= f.email_field :email, autocomplete: "email", class: "form-control" %>
            </div>

            <div class="mb-3">
              <%= f.label :address, "Street Address", class: "form-label fw-semibold" %>
              <%= f.text_field :address, class: "form-control" %>
            </div>

            <div class="row g-3 mb-3">
              <div class="col-md-5">
                <%= f.label :city, class: "form-label fw-semibold" %>
                <%= f.text_field :city, class: "form-control" %>
              </div>

              <div class="col-md-4">
                <%= f.label :province_id, "Province", class: "form-label fw-semibold" %>
                <%= f.collection_select :province_id, Province.order(:name), :id, :name,
                                        { include_blank: "Select Province" },
                                        { class: "form-select" } %>
              </div>

              <div class="col-md-3">
                <%= f.label :postal_code, "Postal Code", class: "form-label fw-semibold" %>
                <%= f.text_field :postal_code, class: "form-control" %>
              </div>
            </div>

            <div class="mb-3">
              <%= f.label :password, class: "form-label fw-semibold" %>
              <% if @minimum_password_length %>
                <div class="form-text mb-1">(<%= @minimum_password_length %> characters minimum)</div>
              <% end %>
              <%= f.password_field :password, autocomplete: "new-password", class: "form-control" %>
            </div>

            <div class="mb-4">
              <%= f.label :password_confirmation, "Confirm Password", class: "form-label fw-semibold" %>
              <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control" %>
            </div>

            <div class="d-grid mb-3">
              <%= f.submit "Sign Up", class: "btn btn-primary" %>
            </div>
          <% end %>

          <hr class="my-3">

          <div class="text-center small">
            <%= render "users/shared/links" %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>