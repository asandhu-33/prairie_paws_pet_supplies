<div class="container">
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h1 class="h2 mb-0">Pet Supplies Catalog</h1>
    <%= link_to "Reset Filters", products_path, class: "btn btn-outline-secondary btn-sm" %>
  </div>

  <div class="d-flex flex-wrap gap-2 mb-4">
    <%= link_to "All Products",
                products_path(request.query_parameters.except("filter", "page")),
                class: "btn btn-sm #{params[:filter].blank? ? 'btn-dark' : 'btn-outline-dark'}" %>
    <%= link_to "On Sale",
                products_path(request.query_parameters.merge(filter: "sale").except("page")),
                class: "btn btn-sm #{%w[sale on_sale].include?(params[:filter]) ? 'btn-danger' : 'btn-outline-danger'}" %>
    <%= link_to "New (Last 3 Days)",
                products_path(request.query_parameters.merge(filter: "new").except("page")),
                class: "btn btn-sm #{params[:filter] == 'new' ? 'btn-success' : 'btn-outline-success'}" %>
  </div>

  <% if @products.any? %>
    <div class="row row-cols-1 row-cols-md-3 g-4">
      <% @products.each do |product| %>
        <div class="col">
          <div class="card h-100">
            <% if product.image.attached? %>
              <%= image_tag product.image, class: "card-img-top", style: "height: 200px; object-fit: cover;", alt: product.name %>
            <% end %>
            <div class="card-body d-flex flex-column">
              <div class="d-flex flex-wrap gap-1 mb-2">
                <span class="badge bg-secondary"><%= product.category.name %></span>
                <% if product.on_sale? %>
                  <span class="badge bg-danger">On Sale</span>
                <% end %>
                <% if product.created_at && product.created_at >= 3.days.ago %>
                  <span class="badge bg-success">New</span>
                <% end %>
              </div>
              <h2 class="h6 card-title"><%= link_to product.name, product_path(product), class: "text-decoration-none text-dark" %></h2>
              <p class="card-text text-muted small flex-grow-1"><%= truncate(product.description, length: 100) %></p>
              <div class="d-flex justify-content-between align-items-center mt-3">
                <strong class="fs-5">$<%= number_with_precision(product.price, precision: 2) %></strong>
                <%= link_to "View Details", product_path(product), class: "btn btn-primary btn-sm" %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <div class="mt-4 d-flex justify-content-center">
      <% if @products.respond_to?(:current_page) %>
        <%= paginate @products %>
      <% elsif @total_pages && @total_pages > 1 %>
        <nav class="d-flex gap-2">
          <% if @page > 1 %>
            <%= link_to "Previous", products_path(request.query_parameters.merge(page: @page - 1)), class: "btn btn-outline-primary btn-sm" %>
          <% end %>
          <span class="btn btn-light btn-sm disabled">Page <%= @page %> of <%= @total_pages %></span>
          <% if @page < @total_pages %>
            <%= link_to "Next", products_path(request.query_parameters.merge(page: @page + 1)), class: "btn btn-outline-primary btn-sm" %>
          <% end %>
        </nav>
      <% end %>
    </div>
  <% else %>
    <div class="alert alert-info">No products matched your search or filter.</div>
  <% end %>
</div>